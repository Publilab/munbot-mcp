# Archivo de ejemplo de variables de entorno para evolution-manager
# Buenas prácticas de Publilab Consulting: centraliza la configuración aquí y nunca subas archivos .env reales al repositorio

# URL base de la API Evolution (puede ser http://localhost:9615 o la IP/host de tu contenedor)
VITE_API_URL=http://localhost:9615

# Puerto del frontend (opcional, depende de tu configuración de Docker/Vite)
VITE_PORT=3000
HF_API_TOKEN=<YOUR_TOKEN_HERE>
# Configuración opcional para la selección de colección según la categoría
RAG_COLLECTION_FAQ=munbot_faq
RAG_COLLECTION_TRAMITES=munbot_tramites
RAG_COLLECTION_NORMATIVA=munbot_normativa
RAG_CATEGORY_AWARE=0
