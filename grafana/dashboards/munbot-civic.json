      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "civic-postgres"
          },
          "format": "table",
          "rawSql": "SELECT\n  COALESCE(channel, 'sin canal') AS metric,\n  SUM(total_interacciones) AS value\nFROM civic_daily_kpis\nWHERE $__timeFilter(day_bucket)\nGROUP BY channel\nORDER BY value DESC;",
          "refId": "A"
        }
      ],
      "title": "Distribución por canal",
      "type": "bargauge"
    },
