        {
          "alias": "Interacciones",
          "datasource": {
            "type": "postgres",
            "uid": "civic-postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(day_bucket, '1d') AS time,\n  SUM(total_interacciones) AS value\nFROM civic_daily_kpis\nWHERE $__timeFilter(day_bucket)\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        },
        {
          "alias": "Resueltas",
          "datasource": {
            "type": "postgres",
            "uid": "civic-postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(day_bucket, '1d') AS time,\n  SUM(resolved_interactions) AS value\nFROM civic_daily_kpis\nWHERE $__timeFilter(day_bucket)\nGROUP BY 1\nORDER BY 1;",
          "refId": "B"
        },
        {
          "alias": "Fallbacks",
          "datasource": {
            "type": "postgres",
            "uid": "civic-postgres"
          },
          "format": "time_series",
          "rawSql": "SELECT\n  $__timeGroupAlias(day_bucket, '1d') AS time,\n  SUM(fallbacks) AS value\nFROM civic_daily_kpis\nWHERE $__timeFilter(day_bucket)\nGROUP BY 1\nORDER BY 1;",
          "refId": "C"
        }
      ],
      "title": "Interacciones cívicas (últimos días)",
      "type": "timeseries"
    },
