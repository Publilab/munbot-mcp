        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "civic-postgres"
          },
          "format": "table",
          "rawSql": "SELECT\n  date_trunc('day', day_bucket) AS \"Día\",\n  department AS \"Departamento\",\n  status AS \"Estado\",\n  SUM(total_eventos) AS \"Eventos\"\nFROM civic_service_summary\nWHERE $__timeFilter(day_bucket)\nGROUP BY 1, 2, 3\nORDER BY 1 DESC, 4 DESC;",
          "refId": "A"
        }
      ],
      "title": "Eventos de servicios municipales",
      "type": "table"
    }
