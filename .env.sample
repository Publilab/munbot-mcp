# Unified .env.sample for munbot-mcp
# Copy this file to .env and fill in the actual values.

# =====================================
# Service URLs
# =====================================
# Example:
# DATABASE_URL=postgresql://user:password@host:port/database
# SCHEDULER_HEALTH_URL=http://scheduler-mcp:6001/health
# COMPLAINTS_HEALTH_URL=http://complaints-mcp:7000/health

# =====================================
# Telemetry & Observability
# =====================================
# TELEMETRY_ENABLED: Activates structured logging and metrics export.
TELEMETRY_ENABLED=1

# LOG_FORMAT: Use 'json' for machine-readable logs or 'text' for human-readable.
LOG_FORMAT=json

# REDACTION_ENABLED: Set to 1 to redact PII (RUT, email, phone) from logs.
REDACTION_ENABLED=1

# TRACE_SAMPLING: Fraction of conversations to log with full (anonymized) traces (0.0 to 1.0).
TRACE_SAMPLING=0.15

# TRACE_SALT: A secret salt for hashing session_ids in traces.
TRACE_SALT=munbot_salt_replace_me

# PROMETHEUS_ENABLED: Set to 1 to expose a /metrics endpoint.
PROMETHEUS_ENABLED=1

# =====================================
# Canary Rollout
# =====================================
# AGENT_CANARY_RATIO: Fraction of sessions/requests that should use the agent (0.0 to 1.0).
AGENT_CANARY_RATIO=0.2

# AGENT_CANARY_HEADER_KEY: HTTP header to force canary mode for a request.
AGENT_CANARY_HEADER_KEY=x-agent-canary

# AGENT_CANARY_HEADER_ON: Value of the header that activates canary mode.
AGENT_CANARY_HEADER_ON=1
