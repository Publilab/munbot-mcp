# Unified .env.sample for munbot-mcp
# Copy this file to .env and fill in the actual values.

# =====================================
# Service URLs
# =====================================
# Example:
# DATABASE_URL=postgresql://user:password@host:port/database
# QDRANT_URL=http://qdrant:6333
# SCHEDULER_HEALTH_URL=http://scheduler-mcp:6001/health
# COMPLAINTS_HEALTH_URL=http://complaints-mcp:7000/health

# =====================================
# Feature Flags & Agent Tuning
# =====================================
# AGENT_MODE: Activates agent mode in llm_docs-mcp/orchestrator (0=off, 1=on)
AGENT_MODE=0

# RAG_CATEGORY_AWARE: Enables RAG to select collection/filter by category (0=off, 1=on)
RAG_CATEGORY_AWARE=0

# AGENT_MAX_TOOL_CALLS: Limit of tool calls per agent turn
AGENT_MAX_TOOL_CALLS=2

# RAG_COLLECTION_*: Collection names (or aliases) for each category
RAG_COLLECTION_FAQ=faq
RAG_COLLECTION_TRAMITES=tramites
RAG_COLLECTION_NORMATIVA=normativa

# RAG_SELECTION_MODE: How to select RAG data by category ('collection' or 'filter').
RAG_SELECTION_MODE=collection

# RAG_FILTER_FIELD: If RAG_SELECTION_MODE=filter, specifies the metadata field to use (e.g., "tipo").
RAG_FILTER_FIELD=tipo

# =====================================
# Agent Guardrails (llm_docs-mcp)
# =====================================
# Timeout in seconds for the LLM to generate a response within the agent loop.
AGENT_LLM_TIMEOUT_SEC=8

# Timeout in seconds for a tool handler to execute.
AGENT_HANDLER_TIMEOUT_SEC=4

# Number of retries for a timed-out operation (0 or 1 recommended).
AGENT_MAX_RETRIES=1

# =====================================
# Telemetry & Observability
# =====================================
# TELEMETRY_ENABLED: Activates structured logging and metrics export.
TELEMETRY_ENABLED=1

# LOG_FORMAT: Use 'json' for machine-readable logs or 'text' for human-readable.
LOG_FORMAT=json

# REDACTION_ENABLED: Set to 1 to redact PII (RUT, email, phone) from logs.
REDACTION_ENABLED=1

# TRACE_SAMPLING: Fraction of conversations to log with full (anonymized) traces (0.0 to 1.0).
TRACE_SAMPLING=0.15

# TRACE_SALT: A secret salt for hashing session_ids in traces.
TRACE_SALT=munbot_salt_replace_me

# PROMETHEUS_ENABLED: Set to 1 to expose a /metrics endpoint.
PROMETHEUS_ENABLED=1

# =====================================
# Canary Rollout
# =====================================
# AGENT_CANARY_RATIO: Fraction of sessions/requests that should use the agent (0.0 to 1.0).
AGENT_CANARY_RATIO=0.2

# AGENT_CANARY_HEADER_KEY: HTTP header to force canary mode for a request.
AGENT_CANARY_HEADER_KEY=x-agent-canary

# AGENT_CANARY_HEADER_ON: Value of the header that activates canary mode.
AGENT_CANARY_HEADER_ON=1

# =====================================
# Interpretativas (ML/LLM externo)
# =====================================
# INTERP_LLM_MODE: off | gemini | llama_cpp
INTERP_LLM_MODE=off

# INTERP_LLM_MODEL: Modelo externo a usar (Gemini por defecto recomendado).
INTERP_LLM_MODEL=gemini-2.0-flash-lite

# INTERP_LLM_ENDPOINT: Endpoint base para Gemini API.
INTERP_LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# INTERP_LLM_API_KEY: API key del proveedor externo.
INTERP_LLM_API_KEY=

# INTERP_LLM_MAX_TOKENS: Límite de salida para interpretativas.
INTERP_LLM_MAX_TOKENS=512

# INTERP_LLM_TEMPERATURE: Temperatura (0.0–1.0).
INTERP_LLM_TEMPERATURE=0.2

# =====================================
# LLM triage (resolver intent ambiguo)
# =====================================
LLM_TRIAGE_ENABLED=0
LLM_TRIAGE_THRESHOLD=0.55

# =====================================
# Runtime flags (degradación)
# =====================================
FAQ_ONLY_MODE=0
EMBEDDINGS_ENABLED=1
RERANK_ENABLED=1
